App(
    appid="dndolphins",
    name="DNDolphins",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="dndolphins_app",
    stack_size=6 * 1024,
    flags=["UnloadAssetPacks"],
    sources=[
        "dndolphins.c",
        "dnd_handoff.c",
        "dnd_data.c",
        "dnd_rules_core.c",
        "dndolphins_rules_character.c",
        "dndolphins_dice.c",
        "dnd_weapon_rules.c",
        "dndolphins_weapon_combat.c",
        "dnd_spell_eligibility.c",
        "dndolphins_spells.c",
        "dndolphins_spell_combat.c",
        "dnd_storage.c",
        "dndolphins_progression_store.c",
    ],
    fap_icon="icon.png",
    fap_file_assets="character_assets",
    fap_category="Games",
    fap_author="RogueMaster",
    fap_weburl="https://github.com/RogueMaster/Dungeons_and_Dolphins",
    fap_version="3.3.6",
    fap_description="Offline 5E-compatible character, progression, dice, and combat hub.",
)


